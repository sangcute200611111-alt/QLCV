<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CHI TIẾT CÔNG VIỆC"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        android:layout_marginBottom="24dp"/>

    <!-- Hiển thị tên công việc -->
    <TextView
        android:id="@+id/tvChiTietTen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#333333"
        android:layout_marginBottom="16dp"/>

    <!-- Hiển thị mô tả công việc -->
    <TextView
        android:id="@+id/tvChiTietMoTa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#555555"/>

    <TextView
        android:id="@+id/tvChiTietTrangThai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trạng thái: Chưa hoàn thành"
        android:textSize="16sp"
        android:textColor="#C62828"
        android:layout_marginBottom="24dp"/>

</LinearLayout>